{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "codebuild:CreateReport",
        "codebuild:CreateReportGroup"
      ],
      "Resource": ["*"]
%{ if artifact_type == "S3" ~}
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${s3_bucket}",
        "arn:aws:s3:::${s3_bucket}/*"
      ]
%{ endif ~}
    },

    {
      "Sid": "DeleteOldRelease",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::${s3_bucket}/${artifact_path}/*"
      ]
    }
  ]
}