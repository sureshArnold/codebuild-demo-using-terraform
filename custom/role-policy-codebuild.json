{
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Effect" : "Allow",
        "Action" : [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource" : ["*"]
      },

      {
        "Effect" :"Allow",
        "Action":[

            "s3:GetObject",
            "s3:GetObjectVersion",
            "s3:PutObject"
        ],
        "Resource" : [
            "arn:aws:s3:::${s3_bucket}${artifact_path}",
            "arn:aws:s3:::${s3_bucket}/*"
        ]
      },

      {
        "Sid" : "DeleteOldRelease",
        "Effect":"Allow",
        "Action":[
            "s3:DeleteO*"
        ],
        "Resource" :[
            "arn:aws:s:::${s3_bucket}${artifact_path}"
        ]
      }

    ]

}
